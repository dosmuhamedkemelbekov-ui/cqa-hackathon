# Скопируйте в .env и заполните.

# --- Облачная модель OpenAI ---
OPENAI_API_KEY=sk-...
CQA_MODEL=gpt-5.6-luna

# --- Или локальная модель через OpenAI-совместимый API (Ollama / LM Studio / vLLM) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# CQA_MODEL=qwen2.5:14b

# Параллельных запросов к LLM
CQA_CONCURRENCY=8
# Прогонов на критерий (>1 — голосование большинством, точнее, но дороже)
CQA_SAMPLES=1

# Цена модели за 1M токенов, USD — для расчёта стоимости одной оценки
CQA_PRICE_INPUT_PER_M=2.0
CQA_PRICE_CACHED_INPUT_PER_M=0.5
CQA_PRICE_OUTPUT_PER_M=8.0

# --- Claude (Anthropic) ---
# Включить: CQA_PROVIDER=anthropic и вписать ключ из console.anthropic.com
# CQA_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Модель: claude-opus-5-5 (по умолчанию, $4/$20 за 1M), claude-sonnet-5-5 ($2/$10), claude-haiku-5-5 ($0.10/$0.50)
# CQA_CLAUDE_MODEL=claude-opus-5-5
# Глубина рассуждения: low | medium | high | xhigh | max
# CQA_CLAUDE_EFFORT=medium

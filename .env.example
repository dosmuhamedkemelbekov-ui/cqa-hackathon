# Скопируйте в .env и заполните.

# --- Облачная модель OpenAI ---
OPENAI_API_KEY=sk-...
CQA_MODEL=gpt-5.6-luna

# --- Или локальная модель через OpenAI-совместимый API (Ollama / LM Studio / vLLM) ---
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# CQA_MODEL=qwen2.5:14b

# Параллельных запросов к LLM
CQA_CONCURRENCY=8
# Прогонов на критерий (>1 — голосование большинством, точнее, но дороже)
CQA_SAMPLES=1

# Цена модели за 1M токенов, USD — для расчёта стоимости одной оценки
CQA_PRICE_INPUT_PER_M=2.0
CQA_PRICE_CACHED_INPUT_PER_M=0.5
CQA_PRICE_OUTPUT_PER_M=8.0

# Распознавание речи для загруженных аудиозаписей (кнопка «+ Новый диалог» → аудио).
# По умолчанию используется OPENAI_API_KEY; для локальной LLM задайте отдельный ключ OpenAI.
# CQA_STT_MODEL=whisper-1
# CQA_STT_API_KEY=sk-...
# CQA_STT_BASE_URL=
# --- Бесплатные варианты (OpenAI-совместимый API; раскомментируйте ОДИН блок) ---
# Чтобы не упираться в поминутные лимиты: CQA_CONCURRENCY=2, CQA_DIALOG_CONCURRENCY=1, CQA_VERIFY=0
# Google Gemini (ключ: aistudio.google.com → Get API key, без карты). Точное имя модели — в AI Studio.
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AIza...
# CQA_MODEL=gemini-2.5-flash
# Groq (console.groq.com, без карты; дневной лимит токенов небольшой)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# CQA_MODEL=openai/gpt-oss-120b
# OpenRouter, бесплатные модели с суффиксом :free (всего ~50 запросов в день без покупки кредитов)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# CQA_MODEL=openrouter/free

# --- Claude (Anthropic) ---
# Включить: CQA_PROVIDER=anthropic и вписать ключ из console.anthropic.com
# CQA_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Модель: claude-opus-5-5 (по умолчанию, $4/$20 за 1M), claude-sonnet-5-5 ($2/$10), claude-haiku-5-5 ($0.10/$0.50)
# CQA_CLAUDE_MODEL=claude-opus-5-5
# Глубина рассуждения: low | medium | high | xhigh | max
# CQA_CLAUDE_EFFORT=medium

# Название команды для results.json (results/dev, results/prod)
CQA_TEAM_NAME=Название команды
